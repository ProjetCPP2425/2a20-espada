   <property name="styleSheet">
    <string notr="true">QTableView#tab_affichage {
    background-color: transparent;
    /*border: 2px solid #137C8B;
    border-radius: 10px;*/
    gridline-color: #709CA7;
    font: bold 13px &quot;Segoe UI&quot;;
    selection-background-color: #B8CBD0;
    selection-color: white;
    color: black;
}

/* En-tête du tableau */
QHeaderView::section {
    background-color: #344D59;
    color: white;
    padding: 5px;
    border: 1px solid black;
    font: bold 13px &quot;Segoe UI&quot;;
}

/* Style des lignes impaires */
QTableView#tab_affichage::item:alternate {
    background-color: #B8CBD0;
}

/* Scrollbar verticale */
QScrollBar:vertical {
    border: 1px solid #137C8B;
    background: #7A90A4;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #709CA7;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::add-line:vertical, 
QScrollBar::sub-line:vertical {
    background: none;
}

/* Scrollbar horizontale */
QScrollBar:horizontal {
    border: 1px solid #137C8B;
    background: #7A90A4;
    height: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #709CA7;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::add-line:horizontal, 
QScrollBar::sub-line:horizontal {
    background: none;
}
</string>
   </property>
